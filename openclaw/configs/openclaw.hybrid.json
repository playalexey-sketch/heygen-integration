{
  "$schema": "https://docs.openclaw.ai/schemas/openclaw.json",

  "//": "Оба движка сразу: основной llama.cpp, запасной Ollama.",
  "//1": "В чате Telegram переключение на лету: /model ollama/qwen3:8b",
  "//2": "Это же лучший способ понять, кто виноват: если на одном провайдере",
  "//3": "бот отвечает, а на другом молчит — проблема в движке, не в OpenClaw.",

  "models": {
    "mode": "merge",
    "providers": {
      "llamacpp": {
        "baseUrl": "http://127.0.0.1:8080/v1",
        "apiKey": "sk-local",
        "api": "openai-completions",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "local-model",
            "name": "Local (llama.cpp)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 32768,
            "maxTokens": 4096
          }
        ]
      },
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434",
        "apiKey": "ollama-local",
        "api": "ollama",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "qwen3:8b",
            "name": "qwen3:8b",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 32768,
            "maxTokens": 8192,
            "params": { "num_ctx": 32768, "keep_alive": "15m", "thinking": false }
          }
        ]
      }
    }
  },

  "agents": {
    "defaults": {
      "model": {
        "primary": "llamacpp/local-model",
        "fallbacks": ["ollama/qwen3:8b"]
      },
      "models": {
        "llamacpp/local-model": { "alias": "Local" },
        "ollama/qwen3:8b": { "alias": "Ollama" }
      }
    }
  },

  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "ВСТАВЬТЕ_ТОКЕН_ОТ_BOTFATHER",
      "dmPolicy": "allowlist",
      "allowFrom": ["ВАШ_ЧИСЛОВОЙ_TELEGRAM_ID"],
      "groups": { "*": { "requireMention": true } },
      "errorPolicy": "always"
    }
  },

  "plugins": { "entries": { "telegram": { "enabled": true } } },

  "gateway": { "port": 18789, "mode": "local", "bind": "loopback" }
}
