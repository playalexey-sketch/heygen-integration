{
  "$schema": "https://docs.openclaw.ai/schemas/openclaw.json",

  "//": "Вариант без Ollama через LM Studio (GUI поверх llama.cpp).",
  "//1": "Включите в LM Studio: Developer → Start Server (порт 1234).",
  "//2": "Точный id модели: curl http://localhost:1234/api/v1/models → поле key",

  "models": {
    "mode": "merge",
    "providers": {
      "lmstudio": {
        "baseUrl": "http://127.0.0.1:1234/v1",
        "apiKey": "lmstudio",
        "api": "openai-completions",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "qwen/qwen3-8b",
            "name": "Qwen3 8B (LM Studio)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 32768,
            "maxTokens": 4096
          }
        ]
      }
    }
  },

  "agents": {
    "defaults": {
      "model": { "primary": "lmstudio/qwen/qwen3-8b" }
    }
  },

  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "ВСТАВЬТЕ_ТОКЕН_ОТ_BOTFATHER",
      "dmPolicy": "allowlist",
      "allowFrom": ["ВАШ_ЧИСЛОВОЙ_TELEGRAM_ID"],
      "groups": { "*": { "requireMention": true } }
    }
  },

  "plugins": { "entries": { "telegram": { "enabled": true } } },

  "gateway": { "port": 18789, "mode": "local", "bind": "loopback" }
}
