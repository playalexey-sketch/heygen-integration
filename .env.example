# HeyGen API Configuration
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_BASE_URL=https://api.heygen.com

# Webhook (optional)
WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/heygen
CALLBACK_URL=https://your-domain.com/api/v1/webhooks/heygen

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# UI Settings
UI_PORT=8501

# Instagram competitor Reels agent (optional)
# Create in Apify Console and keep it out of Git/chat.
APIFY_TOKEN=your_apify_token_here

# Optional OpenAI-compatible analysis endpoint.
# Without these variables the agent uses deterministic clean-room templates.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your_model_name_here
