# HeyGen API Configuration
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_BASE_URL=https://api.heygen.com

# Webhook (optional)
WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/heygen
CALLBACK_URL=https://your-domain.com/api/v1/webhooks/heygen

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# UI Settings
UI_PORT=8501

# --- Timeweb Cloud agent (timeweb_agent/) ---
# Подробный шаблон с комментариями: timeweb_agent/.env.example
# (скопируйте его в корень репозитория как .env)
# Токен панели Timeweb Cloud: https://timeweb.cloud/my/api-keys
TIMEWEB_CLOUD_TOKEN=your_timeweb_token_here
# SSH-доступ к VPS для деплоев
TW_SSH_HOST=
TW_SSH_PORT=22
TW_SSH_USER=root
TW_SSH_PASSWORD=
# TW_SSH_KEY_PATH=/путь/к/приватному/ключу
# Веб-панель агента (python -m timeweb_agent web / run_twagent_web.bat)
TW_WEB_HOST=127.0.0.1
TW_WEB_PORT=8050
