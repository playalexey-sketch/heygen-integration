# ─────────────────────────────────────────────────────────────
#  LTX-2 photo→video agent — переменные окружения для облака
#  Скопируйте в .env и заполните перед развёртыванием.
# ─────────────────────────────────────────────────────────────

# Сервер
HOST=0.0.0.0
PORT=8001

# Выходная папка для готовых видео
LTX2_OUTPUT_DIR=/app/ltx2_output
LTX2_WORKDIR=/app/ltx2_work

# ── Пути к весам LTX-2 (загрузите модели, см. GUIDE.md) ─────
LTX2_CHECKPOINT=/app/models/ltx-2.3/ltx-2.3-22b-dev.safetensors
LTX2_SPATIAL_UPSAMPLER=/app/models/ltx-2.3/ltx-2.3-spatial-upscaler-x2-1.1.safetensors
LTX2_DISTILLED_LORA=/app/models/ltx-2.3/ltx-2.3-22b-distilled-lora-384-1.1.safetensors
LTX2_GEMMA_ROOT=/app/models/gemma-3-12b

# Hugging Face токен (для скачивания gated-моделей LTX-2.3)
# Получить: https://huggingface.co/settings/tokens (Read, доступ к gated-репо)
HF_TOKEN=

# ── Если хотите облачную озвучку голосом (опционально) ──────
# HEYGEN_API_KEY=
