# ===== ОБЯЗАТЕЛЬНО: токен бота =====
# Токен выдаёт @BotFather в Telegram: команда /newbot -> имя -> токен вида 123456789:AA...
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# ===== ВАШ Telegram ID (число) =====
# Узнать свой ID: напишите боту @userinfobot в Telegram.
# Можно указать несколько через запятую: 123456789, 987654321
#
# Оставить ПУСТЫМ можно только на время первого запуска:
# тогда первым админом станет тот, кто первым пришлёт боту /admin (один раз!).
ADMIN_ID=

# ===== Каталог для данных (по умолчанию bot_data) =====
# Здесь хранится stages.json — ваши настроенные этапы.
# В Docker уже задан /app/bot_data с монтированием ./bot_data.
# DATA_DIR=bot_data

# ===== Веб-панель администратора =====
# Бот стартует и веб-панель: http://localhost:8080
# (с других машин — http://<IP вашего сервера>:8080)
WEB_PORT=8080

# Пароль для входа в веб-панель.
# Оставить пустым — при первом запуске пароль сгенерируется сам
# и будет показан в логе + сохранён в bot_data/admin_password.txt.
# ЛУЧШЕ задать сразу: ADMIN_PASSWORD=какой_то_надёжный_пароль
ADMIN_PASSWORD=
