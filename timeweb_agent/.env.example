# =====================================================================
#  НАСТРОЙКИ АГЕНТА TIMEWEB CLOUD  (CLI + веб-панель)
# =====================================================================
#  Как использовать:
#   1. Скопируйте этот файл в КОРЕНЬ репозитория с именем .env:
#        Windows:   copy timeweb_agent\.env.example .env
#        Linux/Mac: cp timeweb_agent/.env.example .env
#      (Либо положите рядом: timeweb_agent/.env — тоже сработает.)
#   2. Заполните значения ниже. Обязателен только токен; SSH — нужен
#      для диагностики и деплоя на ваш VPS.
#   3. Запустите веб-панель двойным кликом:
#        run_twagent_web.bat   (Windows)
#        run_twagent_web.sh    (Linux/Mac)
#      Или командой:  python -m timeweb_agent web
#
#  Файл .env внесён в .gitignore — он НИКОГДА не попадёт в Git.
# =====================================================================


# ---------------------------------------------------------------------
# 1) ТОКЕН ПАНЕЛИ TIMEWEB CLOUD  —  ОБЯЗАТЕЛЬНО
# ---------------------------------------------------------------------
# Где взять:
#   Панель Timeweb → раздел «API и Terraform» → «Создать токен».
#   Прямая ссылка:  https://timeweb.cloud/my/api-keys
# Вставьте значение токена сюда (кавычки не нужны).
TIMEWEB_CLOUD_TOKEN=вставьте_сюда_ваш_токен

# Адрес API Timeweb — менять не нужно.
TIMEWEB_API_URL=https://api.timeweb.cloud/api/v1


# ---------------------------------------------------------------------
# 2) SSH-ДОСТУП К ВАШЕМУ VPS  —  нужно для диагностики и деплоя
# ---------------------------------------------------------------------
# IP-адрес сервера. Где посмотреть:
#   Панель Timeweb → «Облачные серверы» → карточка вашего сервера
#   (IPv4 вида 185.105.1.42). Либо команда поддержки `ip a`.
TW_SSH_HOST=123.123.123.123

# Порт SSH. На новых серверах Timeweb — 22.
TW_SSH_PORT=22

# Пользователь. На свежих серверах Ubuntu это root.
# root-пароль показан в панели сервера (раздел «Пароль»).
TW_SSH_USER=root

# СПОСОБ ВХОДА №1 — по паролю:
TW_SSH_PASSWORD=ваш_пароль_root

# СПОСОБ ВХОДА №2 — по SSH-ключу (используйте ВМЕСТО пароля,
# раскомментируйте строку и укажите путь к ПРИВАТНОМУ ключу):
#   Windows:   TW_SSH_KEY_PATH=C:\Users\Вася\.ssh\id_ed25519
#   Linux/Mac: TW_SSH_KEY_PATH=/home/вася/.ssh/id_ed25519
#TW_SSH_KEY_PATH=

# Парольная фраза от ключа (если ключ создан с passphrase):
#TW_SSH_KEY_PASSPHRASE=


# ---------------------------------------------------------------------
# 3) ИНТЕЛЛЕКТУАЛЬНЫЙ СЛОЙ (понимание запросов на естественном языке)
# ---------------------------------------------------------------------
# Без настроек работает ВСТРОЕННЫЙ анализатор правил (русский язык).
# Чтобы помощник стал по-настоящему «умным», подключите LLM — один
# из трёх вариантов ниже. Агент сам выберет: TW_AI_AGENT_ID → Timeweb,
# TW_AI_URL → свой сервер, TW_AI_TOKEN → OpenAI.

# ВАРИАНТ 1 (рекомендуется): Timeweb Cloud AI — оплата в рублях с того
# же аккаунта Timeweb.
#   Панель → раздел «AI-агенты» (https://timeweb.cloud/my/cloud-ai) →
#   создайте агента с любой моделью (ChatGPT, Claude, DeepSeek, YandexGPT…)
#   → скопируйте его ID вида agt_xxx сюда:
TW_AI_AGENT_ID=

# ВАРИАНТ 2: OpenAI (или OpenRouter / любой OpenAI-совместимый сервер).
#   OpenAI:   TW_AI_URL=https://api.openai.com/v1
#             TW_AI_TOKEN=sk-...
#             TW_AI_MODEL=gpt-4o-mini
#   OpenRouter:
#             TW_AI_URL=https://openrouter.ai/api/v1
#             TW_AI_TOKEN=sk-or-...
#             TW_AI_MODEL=deepseek/deepseek-chat
#   Локальный Ollama:
#             TW_AI_URL=http://localhost:11434/v1
#             TW_AI_TOKEN=ollama
#             TW_AI_MODEL=llama3.1
#TW_AI_URL=
#TW_AI_TOKEN=
#TW_AI_MODEL=

# Таймаут запроса к LLM, секунд.
TW_AI_TIMEOUT=180


# ---------------------------------------------------------------------
# 4) ВЕБ-ПАНЕЛЬ АГЕНТА
# ---------------------------------------------------------------------
# Порт, на котором откроется интерфейс в браузере.
TW_WEB_PORT=8050

# Хост. 127.0.0.1 = панель доступна ТОЛЬКО с вашего компьютера (безопасно).
# Ставьте 0.0.0.0 только если хотите заходить с других устройств.
TW_WEB_HOST=127.0.0.1


# ---------------------------------------------------------------------
# 5) ПОВЕДЕНИЕ АГЕНТА
# ---------------------------------------------------------------------
# Автоматически подтверждать платные и опасные действия:
#   1 = да (не спрашивать),  0 = нет (спрашивать) — рекомендуется 0.
TW_YES=0

# Таймаут запросов к API Timeweb, секунд.
TIMEWEB_API_TIMEOUT=60
